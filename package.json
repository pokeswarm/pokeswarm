{
  "name": "pokeswarm",
  "private": true,
  "version": "0.5.31",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest run --mode bench --silent=false",
    "balance": "vitest run --mode balance --silent=false",
    "sprites": "node scripts/fetch-sprites.ts",
    "pokeapi": "node scripts/fetch-pokeapi.ts",
    "moves-table": "node scripts/moves-table.ts",
    "balance-moves": "node scripts/balance-moves.ts",
    "item-icons": "node scripts/fetch-item-icons.ts",
    "move-sprites": "node scripts/make-move-sprites.ts",
    "map-tiles": "node scripts/make-map-tiles.ts"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "phaser": "^4.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
